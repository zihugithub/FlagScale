ARG CUDA_VERSION=12.8.1

FROM nvcr.io/nvidia/cuda:${CUDA_VERSION}-devel-ubuntu22.04 AS base

ENV DEBIAN_FRONTEND noninteractive
ENV TZ=Asia/Shanghai

WORKDIR /workspace

##############################################################################
# Install Basic Utilities
##############################################################################
RUN apt-get update && \
    apt-get install -y --no-install-recommends apt-utils && \
    echo "N" | apt-get install -y --no-install-recommends pkg-config && \
    apt-get install -y --no-install-recommends \
        autotools-dev \
        build-essential \
        ca-certificates ccache cmake curl \
        emacs \
        gcc git git-lfs g++ \
        htop \
        iftop iotop \
        libcairo2-dev libfontconfig-dev libibverbs1 libibverbs-dev libnuma-dev libx11-dev lsb-release \
        net-tools nfs-common ninja-build \
        openssh-server openssh-client \
        pdsh psmisc \
        rsync \
        screen software-properties-common sudo \
        tmux tzdata \
        unzip \
        vim \
        wget

##############################################################################
# Install Python and essential tools
##############################################################################
ARG PYTHON_VERSION=3.12
RUN set -eux && \
    add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update -y  && \
    apt-get install -y --no-install-recommends \
        python${PYTHON_VERSION} \
        python${PYTHON_VERSION}-dev \
        python${PYTHON_VERSION}-venv \
        python3-distutils \
        python3-pip && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 1 && \
    update-alternatives --set python3 /usr/bin/python${PYTHON_VERSION} && \
    ln -sf /usr/bin/python${PYTHON_VERSION}-config /usr/bin/python3-config && \
    ln -s /usr/bin/python3 /usr/bin/python && \
    python -m ensurepip --upgrade && \
    python -m pip install --upgrade setuptools && \
    # Cleanup
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    # Remove legacy blinker if present
    rm -rf /usr/lib/python3/dist-packages/blinker*

##############################################################################
# Install sccache from official release
##############################################################################
ARG SCCACHE_VERSION=0.12.0
ARG SCCACHE_ARCHIVE=sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl.tar.gz
ENV SCCACHE_BUCKET_NAME=flagscale-build-sccache
ENV SCCACHE_REGION_NAME=cn-north-1
ENV SCCACHE_S3_NO_CREDENTIALS=0
RUN echo "Installing sccache..." && \
        curl -L -o sccache.tar.gz "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/${SCCACHE_ARCHIVE}" && \
        tar -xzf sccache.tar.gz && \
        mv sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl/sccache /usr/bin/sccache && \
        rm -rf sccache.tar.gz sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl && \
        sccache --version

##############################################################################
# OPENMPI
##############################################################################
ENV OPENMPI_BASEVERSION=5.0
ENV OPENMPI_VERSION=${OPENMPI_BASEVERSION}.9
RUN wget -q -O - https://download.open-mpi.org/release/open-mpi/v${OPENMPI_BASEVERSION}/openmpi-${OPENMPI_VERSION}.tar.gz | tar xzf - && \
        cd openmpi-${OPENMPI_VERSION} && \
        ./configure --prefix=/usr/local/openmpi-${OPENMPI_VERSION} && \
        make -j"$(nproc)" install && \
        ln -s /usr/local/openmpi-${OPENMPI_VERSION} /usr/local/mpi && \
        # Sanity check:
        test -f /usr/local/mpi/bin/mpic++ && \
        cd .. && \
        rm -r openmpi-${OPENMPI_VERSION}
ENV PATH=/usr/local/mpi/bin:${PATH} \
        LD_LIBRARY_PATH=/usr/local/lib:/usr/local/mpi/lib:/usr/local/mpi/lib64:${LD_LIBRARY_PATH}
# Create a wrapper for OpenMPI to allow running as root by default
RUN mv /usr/local/mpi/bin/mpirun /usr/local/mpi/bin/mpirun.real && \
        echo '#!/bin/bash' > /usr/local/mpi/bin/mpirun && \
        echo 'mpirun.real --allow-run-as-root --prefix /usr/local/mpi "$@"' >> /usr/local/mpi/bin/mpirun && \
        chmod a+x /usr/local/mpi/bin/mpirun

##############################################################################
# Install Miniconda
##############################################################################
RUN mkdir -p ~/miniconda3 && \
        wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O ~/miniconda3/miniconda.sh && \
        bash ~/miniconda3/miniconda.sh -b -u -p ~/miniconda3 && \
        rm -rf ~/miniconda3/miniconda.sh && \
        ~/miniconda3/bin/conda init bash && \
        ~/miniconda3/bin/conda config --set auto_activate_base false && \
        ~/miniconda3/bin/conda config --set default_python ${PYTHON_VERSION}

##############################################################################
# Install cuDNN (NVIDIA CUDA Deep Neural Network library)
##############################################################################
ARG CUDNN_VERSION=9.15.1
RUN CUDNN_MAJOR=$(echo "${CUDNN_VERSION}" | cut -d. -f1) && \
        CUDNN_MINOR=$(echo "${CUDNN_VERSION}" | cut -d. -f2) && \
        CUDA_MAJOR=$(echo "${CUDA_VERSION}" | cut -d. -f1) && \
        CUDA_MINOR=$(echo "${CUDA_VERSION}" | cut -d. -f2) && \
        wget https://developer.download.nvidia.com/compute/cudnn/redist/cudnn/linux-x86_64/cudnn-linux-x86_64-${CUDNN_VERSION}.9_cuda${CUDA_MAJOR}-archive.tar.xz && \
        tar -xJvf cudnn-linux-x86_64-${CUDNN_VERSION}.9_cuda12-archive.tar.xz && \
        mkdir -p /usr/local/cuda-${CUDA_MAJOR}.${CUDA_MINOR}/include && \
        mkdir -p /usr/local/cuda-${CUDA_MAJOR}.${CUDA_MINOR}/lib64 && \
        cp cudnn-*-archive/include/cudnn*.h /usr/local/cuda-${CUDA_MAJOR}.${CUDA_MINOR}/include/ && \
        cp -P cudnn-*-archive/lib/libcudnn* /usr/local/cuda-${CUDA_MAJOR}.${CUDA_MINOR}/lib64/ && \
        chmod a+r /usr/local/cuda-${CUDA_MAJOR}.${CUDA_MINOR}/include/cudnn*.h /usr/local/cuda-${CUDA_MAJOR}.${CUDA_MINOR}/lib64/libcudnn* && \
        echo "export PATH=/usr/local/cuda-${CUDA_MAJOR}.${CUDA_MINOR}/bin:\$PATH" >> ~/.bashrc && \
        echo "export LD_LIBRARY_PATH=/usr/local/cuda-${CUDA_MAJOR}.${CUDA_MINOR}/lib64:\$LD_LIBRARY_PATH" >> ~/.bashrc && \
        cat /usr/local/cuda-${CUDA_MAJOR}.${CUDA_MINOR}/include/cudnn_version.h | grep CUDNN_MAJOR -A 2

##############################################################################
# Install uv for faster pip installs
##############################################################################
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install uv
# This timeout (in seconds) is necessary when installing some dependencies via uv since it's likely to time out
ENV UV_HTTP_TIMEOUT=500
# Dynamically adjust the concurrency based on the bandwidth limit (typical value is the number of CPU cores multiplied by 2)
ENV UV_CONCURRENCY=256
# Extend the waiting time for long connections to adapt to unstable network environments
ENV UV_CONNECT_TIMEOUT=60
# When the exact version is unavailable, automatically roll back to the semantically compatible highest available version
# ENV UV_INDEX_STRATEGY="unsafe-best-match"
# Use copy mode to avoid hardlink failures with Docker cache mounts
ENV UV_LINK_MODE=copy

##############################################################################
# FlagScale: Base Environment Installation Guide
##############################################################################
COPY requirements/requirements-base.txt requirements/requirements-base.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r ./requirements/requirements-base.txt

##############################################################################
# Set default shell
##############################################################################
SHELL ["/bin/bash", "-c"]

##############################################################################
# Clear
##############################################################################
RUN apt-get clean && \
        rm -rf /var/lib/apt/lists/* && \
        rm -rf /root/.cache/* && \
        rm -rf /workspace/*

##############################################################################
# FlagScale: 
##############################################################################
FROM base AS flagscale-repo

WORKDIR /workspace/FlagScale

COPY ./ ./

##############################################################################
# FlagScale Train: Base Environment Installation Guide
##############################################################################
FROM flagscale-repo AS build_train

##############################################################################
# FlagScale: Building the flagscale-train Conda Environment
##############################################################################
# Load conda environment
RUN /bin/bash ~/miniconda3/etc/profile.d/conda.sh && \
    # Accept the TOS from the main channel
    ~/miniconda3/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    # Accept the TOS from the r channel
    ~/miniconda3/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

# Create and activate Conda virtual environment
# The Python version used has been written into the conda config
RUN ~/miniconda3/bin/conda create --name "flagscale-train" python==3.12 -y 

RUN python -m pip install --upgrade pip

# Install torch
# Define variables for clarity and maintainability
ARG PYTORCH_VER="2.7.1+cu128"
ARG TORCHAUDIO_VER="2.7.1+cu128"
ARG TORCHVISION_VER="0.22.1+cu128"
ARG EXTRA_INDEX="https://download.pytorch.org/whl/cu128"

RUN source /root/miniconda3/bin/activate flagscale-train && \
    pip install \
        torch==$PYTORCH_VER \
        torchaudio==$TORCHAUDIO_VER \
        torchvision==$TORCHVISION_VER \
        --extra-index-url $EXTRA_INDEX

# Train Environment: Dependency Installation
RUN source /root/miniconda3/bin/activate flagscale-train && \
    pip install -r ./requirements/requirements-base.txt

RUN source /root/miniconda3/bin/activate flagscale-train && \
    pip install -r ./requirements/robotics/train/requirements-megatron-nvidia.txt

# Training Environment: TransformerEngine Installation
ARG TRANSFORMER_ENGINE_COMMIT="e9a5fa4e"
RUN source /root/miniconda3/bin/activate flagscale-train && \
    git clone --recursive https://github.com/NVIDIA/TransformerEngine.git && \
    cd TransformerEngine && \
    git checkout ${TRANSFORMER_ENGINE_COMMIT}  && \
    pip install --no-build-isolation . -vvv  && \
    cd .. && \
    rm -r ./TransformerEngine

# Training Environment: Flash Attention Installation
ARG FLASH_ATTN_VERSION="2.8.0.post2"
RUN source /root/miniconda3/bin/activate flagscale-train && \
    # Get cuda|torch|python|cxx versions
    cu=$(nvcc --version | grep 'Cuda compilation tools' | awk '{print $5}' | cut -d '.' -f 1) && \
    torch=$(pip show torch | grep Version | awk '{print $2}' | cut -d '+' -f 1 | cut -d '.' -f 1,2) && \
    cp=$(python3 --version | awk '{print $2}' | awk -F. '{print $1$2}') && \
    cxx=$(g++ --version | grep 'g++' | awk '{print $3}' | cut -d '.' -f 1) && \
    flash_attn_version="${FLASH_ATTN_VERSION}" && \
    echo "flash-attn not found or outdated. Installing v${flash_attn_version}..." && \
    WHEEL_FILENAME="flash_attn-${flash_attn_version}+cu${cu}torch${torch}cxx${cxx}abiFALSE-cp${cp}-cp${cp}-linux_x86_64.whl" && \
    DOWNLOAD_URL="https://github.com/Dao-AILab/flash-attention/releases/download/v${flash_attn_version}/${WHEEL_FILENAME}" && \
    wget --continue --timeout=60 --no-check-certificate --tries=5 --waitretry=10 -O "${WHEEL_FILENAME}" "${DOWNLOAD_URL}" && \
    pip install --break-system-packages --no-cache-dir "${WHEEL_FILENAME}" && \
    rm -rf "${WHEEL_FILENAME}"

# Training Environment: GROUPED GEMM Installation
ARG GROUPED_GEMM_VERSION="1.1.4.post6"
RUN source /root/miniconda3/bin/activate flagscale-train && \
    # Get cuda|torch|python|cxx versions
    cu=$(nvcc --version | grep 'Cuda compilation tools' | awk '{print $5}' | cut -d '.' -f 1) && \
    torch=$(pip show torch | grep Version | awk '{print $2}' | cut -d '+' -f 1 | cut -d '.' -f 1,2) && \
    cp=$(python3 --version | awk '{print $2}' | awk -F. '{print $1$2}') && \
    cxx=$(g++ --version | grep 'g++' | awk '{print $3}' | cut -d '.' -f 1) && \
    grouped_gemm_version="${GROUPED_GEMM_VERSION}" && \
    echo "grouped_gemm not found or outdated. Installing v${grouped_gemm_version}..." && \
    WHEEL_FILENAME="nv_grouped_gemm-${grouped_gemm_version}+cu${cu}torch${torch}cxx${cxx}abiTRUE-cp${cp}-cp${cp}-linux_x86_64.whl" && \
    DOWNLOAD_URL="https://github.com/fanshiqing/grouped_gemm/releases/download/v${grouped_gemm_version}/${WHEEL_FILENAME}" && \
    wget --continue --timeout=60 --no-check-certificate --tries=5 --waitretry=10 -O "${WHEEL_FILENAME}" "${DOWNLOAD_URL}" && \
    pip install --break-system-packages --no-cache-dir "${WHEEL_FILENAME}" && \
    rm -rf "${WHEEL_FILENAME}"

# Training Environment: APEX Installation
RUN source /root/miniconda3/bin/activate flagscale-train && \
    git clone https://github.com/NVIDIA/apex && \
    cd apex && \
    pip install -v \
        --disable-pip-version-check \
        --no-cache-dir \
        --no-build-isolation \
        --config-settings='--build-option=--cpp_ext' \
        --config-settings='--build-option=--cuda_ext' \
        ./ && \
    cd .. && \
    rm -r ./apex

# Used for automatic fault tolerance
# Set the path to the target Python file
RUN source /root/miniconda3/bin/activate flagscale-train && \
    bash -x ./install/train/install-nvidia-megatron.sh \
        --env train \
        --torch-ver ${PYTORCH_VER} \
        --torchaudio-ver ${TORCHAUDIO_VER} \
        --torchvision-ver ${TORCHVISION_VER} \
        --extra-index ${EXTRA_INDEX} \
        --flash-attn-ver ${FLASH_ATTN_VERSION} \
        --group-gemm-ver ${GROUPED_GEMM_VERSION} \
        --transformer-engine-commit ${TRANSFORMER_ENGINE_COMMIT}

##############################################################################
# FlagScale Inference: Base Environment Installation Guide
##############################################################################
FROM flagscale-repo AS build_inference

##############################################################################
# FlagScale: Building the flagscale-inference Conda Environment
##############################################################################
# Load conda environment
RUN /bin/bash ~/miniconda3/etc/profile.d/conda.sh && \
    # Accept the TOS from the main channel
    ~/miniconda3/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    # Accept the TOS from the r channel
    ~/miniconda3/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

# Create and activate Conda virtual environment
# The Python version used has been written into the conda config
RUN ~/miniconda3/bin/conda create --name "flagscale-inference" python=$(python --version | awk '{print $2}' | cut -d '.' -f 1,2) -y

RUN python -m pip install --upgrade pip

# Install torch
ARG PYTORCH_VER="2.7.1+cu128"
ARG TORCHAUDIO_VER="2.7.1+cu128"
ARG TORCHVISION_VER="0.22.1+cu128"
ARG EXTRA_INDEX="https://download.pytorch.org/whl/cu128"

RUN source /root/miniconda3/bin/activate flagscale-inference && \
    pip install \
        torch==${PYTORCH_VER} \
        torchaudio==${TORCHAUDIO_VER} \
        torchvision==${TORCHVISION_VER} \
        --extra-index-url ${EXTRA_INDEX}

# Inference Environment: Dependency Installation
RUN source /root/miniconda3/bin/activate flagscale-inference && \
    pip install -r ./requirements/requirements-base.txt

RUN source /root/miniconda3/bin/activate flagscale-inference && \
    pip install -r ./requirements/robotics/inference/requirements-vllm-nvidia.txt

# Inference Environment: VLLM Dependency Installation
RUN source /root/miniconda3/bin/activate flagscale-inference && \
    python tools/patch/unpatch.py --backend vllm && \
    pip install --no-build-isolation -v ./third_party/vllm/.

# Inference Environment: Dependency Installation
RUN source /root/miniconda3/bin/activate flagscale-inference && \
    pip install -r ./requirements/robotics/server/requirements-vllm-nvidia.txt

# Inference Environment: Dependency Installation
RUN source /root/miniconda3/bin/activate flagscale-inference && \
    bash ./install/inference/install-nvidia-vllm.sh \
        --env inference --llama-cpp-backend cuda \
        --torch-ver ${PYTORCH_VER} \
        --torchaudio-ver ${TORCHAUDIO_VER} \
        --torchvision-ver ${TORCHVISION_VER} \
        --extra-index ${EXTRA_INDEX}

# Inference Environment: FlagGems Dependency Installation
RUN source /root/miniconda3/bin/activate flagscale-inference && \
    pip install git+https://github.com/FlagOpen/FlagGems.git@v3.0

##############################################################################
# FlagScale RL: Base Environment Installation Guide
##############################################################################
FROM flagscale-repo AS build_rl

##############################################################################
# FlagScale: Building the flagscale-inference Conda Environment
##############################################################################
# Load conda environment
RUN /bin/bash ~/miniconda3/etc/profile.d/conda.sh && \
    # Accept the TOS from the main channel
    ~/miniconda3/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    # Accept the TOS from the r channel
    ~/miniconda3/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

# Create and activate Conda virtual environment
# The Python version used has been written into the conda config
RUN ~/miniconda3/bin/conda create --name "flagscale-RL" python==3.10 -y 

RUN python -m pip install --upgrade pip

RUN source /root/miniconda3/bin/activate flagscale-RL && \
    pip install -r requirements/requirements-base.txt

# RL Environment: VERL Installation
RUN source /root/miniconda3/bin/activate flagscale-RL && \
    git clone https://github.com/volcengine/verl.git && \
    cd verl && \
    bash scripts/install_vllm_sglang_mcore.sh && \
    cd .. && \
    rm -r ./verl

# Install dependencies
RUN source /root/miniconda3/bin/activate flagscale-RL && \
    pip install -r requirements/robotics/rl/requirements-verl-nvidia.txt

##############################################################################
# FlagScale Images
##############################################################################
FROM base AS flagscale-train
COPY --from=build_train /root/miniconda3/envs/flagscale-train /root/miniconda3/envs/flagscale-train

FROM base AS flagscale-inference
COPY --from=build_inference /root/miniconda3/envs/flagscale-inference /root/miniconda3/envs/flagscale-inference

FROM base AS flagscale-RL
COPY --from=build_rl /root/miniconda3/envs/flagscale-RL /root/miniconda3/envs/flagscale-RL

FROM base AS flagscale-base
COPY --from=build_train /root/miniconda3/envs/flagscale-train /root/miniconda3/envs/flagscale-train
COPY --from=build_inference /root/miniconda3/envs/flagscale-inference /root/miniconda3/envs/flagscale-inference
COPY --from=build_rl /root/miniconda3/envs/flagscale-RL /root/miniconda3/envs/flagscale-RL
