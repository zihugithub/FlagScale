##############################################################################
# Build FlagScale Multi-Environment Image
# Supports CUDA 12.8.1, cuDNN 9.15.1, Python 3.12, and Torch 2.7.1
##############################################################################

# Set base image parameters
ARG FLAGSCALE_BASE
ARG FLAGSCALE_INFERENCE
ARG FLAGSCALE_TRAIN
ARG FLAGSCALE_RL

# Use pre-built inference image as an intermediate stage
FROM ${FLAGSCALE_INFERENCE} AS inference

# Use pre-built training image as an intermediate stage
FROM ${FLAGSCALE_TRAIN} AS train

# Use pre-built reinforcement learning image as an intermediate stage
FROM ${FLAGSCALE_RL} AS rl

# Final image built from the base image
FROM ${FLAGSCALE_BASE} AS final

# Copy Conda environment from the inference image to the final image
COPY --from=inference /root/miniconda3/envs/flagscale-inference /root/miniconda3/envs/flagscale-inference

# Copy Conda environment from the training image to the final image
COPY --from=train /root/miniconda3/envs/flagscale-train /root/miniconda3/envs/flagscale-train

# Copy Conda environment from the reinforcement learning image to the final image
COPY --from=rl /root/miniconda3/envs/flagscale-RL /root/miniconda3/envs/flagscale-RL
